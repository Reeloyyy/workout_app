  "fixed_sql": [
    {
      "name": "workouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workouts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"tags_json\" TEXT NOT NULL, \"default_rest_seconds\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workout_id\" INTEGER NOT NULL REFERENCES workouts (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"sets\" INTEGER NOT NULL, \"reps\" INTEGER NULL, \"reps_max\" INTEGER NULL, \"duration_seconds\" INTEGER NULL, \"weight\" REAL NULL, \"unit\" TEXT NOT NULL, \"rest_seconds\" INTEGER NULL, \"notes\" TEXT NULL, \"group_key\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workout_id\" INTEGER NULL REFERENCES workouts (id) ON DELETE SET NULL, \"workout_name\" TEXT NOT NULL, \"workout_snapshot_json\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NULL, \"active_exercise_index\" INTEGER NULL, \"rest_ends_at\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "set_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"set_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"exercise_position\" INTEGER NOT NULL, \"exercise_name\" TEXT NOT NULL, \"set_number\" INTEGER NOT NULL, \"reps\" INTEGER NULL, \"weight\" REAL NULL, \"unit\" TEXT NULL, \"duration_seconds\" INTEGER NULL, \"completed_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1 CHECK(\"id\" = 1), \"unit\" TEXT NOT NULL DEFAULT 'kg', \"reminder_days_mask\" INTEGER NOT NULL DEFAULT 0, \"reminder_minutes\" INTEGER NOT NULL DEFAULT 1080, \"sound_on\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sound_on\" IN (0, 1)), \"vibration_on\" INTEGER NOT NULL DEFAULT 1 CHECK (\"vibration_on\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "set_logs_exercise_name_completed_at",
